APP_NAME=LLM Backend Performance Lab
APP_ENV=local
HOST=0.0.0.0
PORT=8000

# mock | openai_compatible
LLM_PROVIDER=mock
MOCK_LLM_DELAY_MS=1200

# OpenAI-compatible provider
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

MAX_LLM_CONCURRENCY=10
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_CONNECT_TIMEOUT_SEC=5
HTTP_READ_TIMEOUT_SEC=30

JOB_WORKERS=4
JOB_QUEUE_MAXSIZE=100
JOB_RESULT_TTL_SEC=3600

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/llm_lab
REDIS_URL=redis://localhost:6379/0

ENABLE_POSTGRES=false
ENABLE_REDIS=false
ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHAT_EVENTS=chat-events
